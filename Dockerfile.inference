# ============================================================
# MyFairMOT-X  —  Inference Image  (multi-stage build)
#
# Stage 1 (builder): compiles Apex + DCNv2 against CUDA devel
# Stage 2 (runtime): lightweight runtime image, copies artifacts
# ============================================================

# -----------------------------------------------------------
# Stage 1: builder — needs full devel toolchain to compile extensions
# -----------------------------------------------------------
FROM nvidia/cuda:11.0.3-cudnn8-devel-ubuntu18.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 python3.8-dev python3-pip \
    git wget curl ca-certificates \
    build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.8 1 \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 \
 && pip3 install --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    torch==1.7.0+cu110 \
    torchvision==0.8.0+cu110 \
    -f https://download.pytorch.org/whl/torch_stable.html

RUN pip install --no-cache-dir Cython==0.29.24 numpy==1.19.5

# Apex
RUN git clone --depth 1 https://github.com/NVIDIA/apex /tmp/apex \
 && cd /tmp/apex \
 && pip install --no-cache-dir -v \
    --disable-pip-version-check \
    --global-option="--cpp_ext" \
    --global-option="--cuda_ext" \
    --prefix=/install . \
 && rm -rf /tmp/apex

# DCNv2
RUN git clone https://github.com/ifzhang/DCNv2.git /tmp/DCNv2 \
 && cd /tmp/DCNv2 \
 && git checkout 41c9ebb3f7e9e563529bb5efc831c3922de72b08 \
 && python setup.py build_ext --inplace \
 && cp -r /tmp/DCNv2 /dcnv2_built

# -----------------------------------------------------------
# Stage 2: runtime — smaller image, no build tools
# -----------------------------------------------------------
FROM nvidia/cuda:11.0.3-cudnn8-runtime-ubuntu18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 python3.8-dev python3-pip \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.8 1 \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 \
 && pip3 install --upgrade pip setuptools wheel

# Copy compiled Apex from builder
COPY --from=builder /install /usr/local

# PyTorch (needed in runtime too)
RUN pip install --no-cache-dir \
    torch==1.7.0+cu110 \
    torchvision==0.8.0+cu110 \
    -f https://download.pytorch.org/whl/torch_stable.html

# Core inference dependencies (no training-only libs like tensorboardX, apex-train)
RUN pip install --no-cache-dir \
    Cython==0.29.24 \
    numpy==1.19.5 \
    opencv-python==4.5.3.56 \
    Pillow==8.2.0 \
    scipy==1.5.4 \
    scikit-learn==0.24.2 \
    lap==0.4.0 \
    cython-bbox==0.1.3 \
    motmetrics==1.2.0 \
    pandas==1.1.5 \
    tqdm==4.61.1 \
    PyYAML==5.4.1 \
    pycocotools==2.0.2 \
    yacs==0.1.8 \
    fire==0.4.0 \
    numba==0.53.1 \
    llvmlite==0.36.0 \
    six==1.16.0 \
    tabulate==0.8.9 \
    termcolor==1.1.0

# Copy pre-built DCNv2 from builder and install
COPY --from=builder /dcnv2_built /tmp/DCNv2
RUN cd /tmp/DCNv2 && pip install --no-build-isolation -e . && rm -rf /tmp/DCNv2

# Copy project source
WORKDIR /workspace/MyFairMOT-X
COPY . .

ENV PYTHONPATH=/workspace/MyFairMOT-X/src

# -----------------------------------------------------------
# Expected volume mounts:
#   -v /path/to/models:/workspace/MyFairMOT-X/models
#   -v /path/to/videos:/workspace/data
#   -v /path/to/output:/workspace/MyFairMOT-X/exp
# -----------------------------------------------------------

CMD ["python", "src/track.py"]
