# ============================================================
# MyFairMOT-X  —  Training Image
# Base: CUDA 11.0.3 + cuDNN 8 (devel)  —  PyTorch 1.7.0+cu110
# ============================================================
FROM nvidia/cuda:11.0.3-cudnn8-devel-ubuntu18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Make compiled CUDA extensions findable at runtime
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# -----------------------------------------------------------
# System packages
# -----------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 python3.8-dev python3-pip \
    git wget curl ca-certificates \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev \
    build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.8 1 \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 \
 && pip3 install --upgrade pip setuptools wheel

# -----------------------------------------------------------
# PyTorch 1.7.0 with CUDA 11.0
# -----------------------------------------------------------
RUN pip install --no-cache-dir \
    torch==1.7.0+cu110 \
    torchvision==0.8.0+cu110 \
    -f https://download.pytorch.org/whl/torch_stable.html

# -----------------------------------------------------------
# Core Python dependencies
# -----------------------------------------------------------
RUN pip install --no-cache-dir \
    Cython==0.29.24 \
    numpy==1.19.5 \
    opencv-python==4.5.3.56 \
    Pillow==8.2.0 \
    matplotlib==3.3.4 \
    scipy==1.5.4 \
    scikit-learn==0.24.2 \
    lap==0.4.0 \
    cython-bbox==0.1.3 \
    motmetrics==1.2.0 \
    pandas==1.1.5 \
    tqdm==4.61.1 \
    tensorboardX==2.3 \
    PyYAML==5.4.1 \
    pycocotools==2.0.2 \
    yacs==0.1.8 \
    fire==0.4.0 \
    numba==0.53.1 \
    llvmlite==0.36.0 \
    six==1.16.0 \
    tabulate==0.8.9 \
    termcolor==1.1.0

# -----------------------------------------------------------
# NVIDIA Apex (mixed-precision training)
# -----------------------------------------------------------
RUN git clone --depth 1 https://github.com/NVIDIA/apex /tmp/apex \
 && cd /tmp/apex \
 && pip install --no-cache-dir -v \
    --disable-pip-version-check \
    --global-option="--cpp_ext" \
    --global-option="--cuda_ext" . \
 && rm -rf /tmp/apex

# -----------------------------------------------------------
# DCNv2 (Deformable Convolution v2) — pinned commit from requirements.txt
# -----------------------------------------------------------
RUN git clone https://github.com/ifzhang/DCNv2.git /tmp/DCNv2 \
 && cd /tmp/DCNv2 \
 && git checkout 41c9ebb3f7e9e563529bb5efc831c3922de72b08 \
 && python setup.py build develop \
 && rm -rf /tmp/DCNv2

# -----------------------------------------------------------
# Copy project source
# -----------------------------------------------------------
WORKDIR /workspace/MyFairMOT-X
COPY . .

ENV PYTHONPATH=/workspace/MyFairMOT-X/src

# -----------------------------------------------------------
# Expected volume mounts:
#   -v /path/to/data:/workspace/data
#   -v /path/to/models:/workspace/MyFairMOT-X/models
#   -v /path/to/exp:/workspace/MyFairMOT-X/exp
# -----------------------------------------------------------

CMD ["python", "src/train.py"]
